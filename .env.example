# Klik Go environment variables — NAMES ONLY. Never commit real values.
# Set real values in Vercel (Preview + Production), GitHub Actions secrets, or a local .env.local.
# Local Supabase values come from `pnpm exec supabase status -o env` after `pnpm db:start`.

# --- Public (safe to expose to the browser; prefixed NEXT_PUBLIC_) ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Pooled connection (Supavisor, transaction mode) for the app at runtime.
DATABASE_URL=
# Direct connection for Prisma CLI / migrations.
DIRECT_URL=
SUPABASE_SERVICE_ROLE_KEY=
# debug | info | warn | error (default info)
LOG_LEVEL=
# Optional; defaults to the short Vercel commit SHA, then "dev".
APP_VERSION=

# Supabase Auth "Send SMS" hook secret ("v1,whsec_…"), same value as the hook settings in Supabase.
SEND_SMS_HOOK_SECRET=
# Semaphore SMS (PH). Without a key, OTP texts are logged (masked) instead of sent.
SEMAPHORE_API_KEY=
# Approved Semaphore sender name, e.g. KLIKGO (optional).
SEMAPHORE_SENDER_NAME=
# Pre-launch only: one shared 6-digit code that signs CUSTOMERS in while SMS is off (any PH
# mobile; riders/staff refused). Ignored once SEMAPHORE_API_KEY is set; needs
# SUPABASE_SERVICE_ROLE_KEY. Set the value in Vercel only. docs/OPEN_QUESTIONS.md Q20.
PLACEHOLDER_OTP_CODE=

# --- AI menu import (Phase 3) ---
# Gemini API key (server only). Only merchants' menu photos are sent, never customer data.
# Without it, "Import menu from a photo" says it isn't set up yet.
GEMINI_API_KEY=
# Gemini model id (optional; default gemini-flash-latest).
GEMINI_MODEL=
# Set to "fake" for local demos and tests to use the built-in sample menu reader (ignored on Vercel production).
MENU_PARSER=

# --- Maps (Phase 4) ---
# Google Maps Platform key with Places API (New) enabled (server only; restrict it by API).
# Without it, address search is hidden and customers place the pin by GPS or by dragging the map.
GOOGLE_MAPS_API_KEY=
# Map tile URL template, e.g. an OSM-based provider (optional; https only; default OpenStreetMap).
# Its origin is added to the CSP img-src automatically.
NEXT_PUBLIC_MAP_TILE_URL=

# --- Payments (Phase 5) ---
# PayMongo secret key (server only): sk_test_… in preview/staging, sk_live_… in production.
# Without it (and without PAYMENT_GATEWAY=fake), checkout offers cash on delivery only.
PAYMONGO_SECRET_KEY=
# Signing secret of the PayMongo webhook pointing at <app>/api/webhooks/paymongo (whsk_…).
PAYMONGO_WEBHOOK_SECRET=
# Set to "fake" for local dev and tests: online payments go to the local /dev/pay page (ignored on Vercel production).
PAYMENT_GATEWAY=

# --- Order alerts and background jobs (Phase 6) ---
# Web Push keys: run `npx web-push generate-vapid-keys` once and keep them (changing them signs everyone out of alerts).
VAPID_PUBLIC_KEY=
# Server only.
VAPID_PRIVATE_KEY=
# Contact for the push services, e.g. mailto:ops@your-domain (required with the keys).
VAPID_SUBJECT=
# Shared secret (32+ random characters) that the database scheduler sends to /api/internal/jobs.
# Put the same value in Supabase Vault as klikgo_cron_secret (docs/OPEN_QUESTIONS.md Q25).
CRON_SECRET=

# --- Scripts ---
# Email of the first admin for `pnpm bootstrap:admin` (also needs SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL).
ADMIN_EMAIL=
