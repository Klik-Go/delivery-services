# Klik Go environment variables — NAMES ONLY. Never commit real values.
# Set real values in Vercel (Preview + Production), GitHub Actions secrets, or a local .env.local.
# Local Supabase values come from `pnpm exec supabase status -o env` after `pnpm db:start`.

# --- Public (safe to expose to the browser; prefixed NEXT_PUBLIC_) ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Pooled connection (Supavisor, transaction mode) for the app at runtime.
DATABASE_URL=
# Direct connection for Prisma CLI / migrations.
DIRECT_URL=
SUPABASE_SERVICE_ROLE_KEY=
# debug | info | warn | error (default info)
LOG_LEVEL=
# Optional; defaults to the short Vercel commit SHA, then "dev".
APP_VERSION=

# Supabase Auth "Send SMS" hook secret ("v1,whsec_…"), same value as the hook settings in Supabase.
SEND_SMS_HOOK_SECRET=
# Semaphore SMS (PH). Without a key, OTP texts are logged (masked) instead of sent.
SEMAPHORE_API_KEY=
# Approved Semaphore sender name, e.g. KLIKGO (optional).
SEMAPHORE_SENDER_NAME=

# --- AI menu import (Phase 3) ---
# Gemini API key (server only). Only merchants' menu photos are sent, never customer data.
# Without it, "Import menu from a photo" says it isn't set up yet.
GEMINI_API_KEY=
# Gemini model id (optional; default gemini-flash-latest).
GEMINI_MODEL=
# Set to "fake" for local demos and tests to use the built-in sample menu reader (ignored on Vercel production).
MENU_PARSER=

# --- Scripts ---
# Email of the first admin for `pnpm bootstrap:admin` (also needs SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL).
ADMIN_EMAIL=
