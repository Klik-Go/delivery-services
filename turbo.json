{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "db:generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma"]
    },
    "build": {
      "dependsOn": ["^db:generate", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.test.ts", "!e2e/**"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "LOG_LEVEL", "APP_VERSION", "VERCEL_GIT_COMMIT_SHA"]
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
