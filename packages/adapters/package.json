{
  "name": "@klikgo/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Implementations of packages/core ports for external services (logging, clock, later PayMongo, SMS, maps\u2026).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
