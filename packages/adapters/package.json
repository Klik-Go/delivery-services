  },
  "dependencies": {
    "@klikgo/core": "workspace:*",
    "@klikgo/db": "workspace:*",
    "@klikgo/types": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@klikgo/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
