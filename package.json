{
  "name": "klik-go",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "test:bdd": "node scripts/with-server.mjs -- node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:e2e": "pnpm --filter @klikgo/web test:e2e",
    "lighthouse": "node scripts/lighthouse-budget.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "db:generate": "turbo run db:generate",
    "test:db": "pnpm db:generate && pnpm --filter @klikgo/db --filter @klikgo/adapters --sequential test:db",
    "bootstrap:admin": "node --import tsx scripts/bootstrap-admin.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cucumber/cucumber": "13.3.0",
    "@klikgo/config": "workspace:*",
    "@klikgo/core": "workspace:*",
    "@klikgo/db": "workspace:*",
    "@klikgo/types": "workspace:*",
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "lighthouse": "13.6.0",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.0.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
